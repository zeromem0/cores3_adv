obj/

*.code-workspace

sdkconfig
sdkconfig.old

# PlatformIO writes a per-environment sdkconfig; sdkconfig.defaults is
# part of the project and stays tracked
sdkconfig.*
!sdkconfig.defaults

# Linker maps written by stray shell redirects
*.map

# A tape built into the firmware is the builder's own business; the
# emulator includes it only when it is there. See the .example beside it.
main/apps/app_zx/assets/builtin_tape.h

# The network seeded at first boot is the builder's own; only the
# example beside it is in the repository.
main/wifi_credentials.h
