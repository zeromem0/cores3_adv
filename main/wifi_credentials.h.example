/*
 * A network to join at the first boot.
 *
 * Copy this to wifi_credentials.h beside it and fill in your own; the
 * copy is ignored by git, so what you put in it stays on your machine.
 * Without the copy nothing is seeded and the network is set from the
 * SetWiFi application, which is where it can be changed afterwards in
 * either case.
 *
 * SPDX-License-Identifier: MIT
 */
#pragma once

#define WIFI_SEED_SSID     "your network"
#define WIFI_SEED_PASSWORD "your password"
